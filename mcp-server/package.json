{
  "name": "agent-delegation-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) Server for subagent delegation and quota-aware load balancing across Antigravity CLI, Codex CLI, and Claude Code.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "agent-delegation-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "node --test dist/tests/**/*.test.js",
    "test:client": "node dist/test-client.js",
    "register": "node dist/register.js",
    "install:mcp": "npm run build && node dist/register.js",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "subagent",
    "delegation",
    "antigravity",
    "codex",
    "claude-code"
  ],
  "author": "Jackie Chen",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
